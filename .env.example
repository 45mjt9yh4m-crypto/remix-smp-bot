# Copia questo file in .env e riempi i valori. Non pubblicare mai il .env!
DISCORD_TOKEN=incolla-qui-il-token-del-bot
# ID del server Discord (tasto destro sul server > Copia ID server)
GUILD_ID=
# Indirizzo del server Minecraft (es. play.remixsmp.it oppure ip:porta)
MC_ADDRESS=
# ID del ruolo staff (vede e gestisce i ticket)
STAFF_ROLE_ID=
# ID della categoria dove creare i canali ticket (facoltativo)
TICKET_CATEGORY_ID=
